  enterpriseObjectId String   @map("enterprise_object_id") @db.Uuid
  ruleCode           String   @map("rule_code")
  ruleName           String   @map("rule_name")
  matchFields        Json     @map("match_fields")
  threshold          Decimal  @db.Decimal(5, 4)
  action             String
  status             String   @default("ACTIVE")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, ruleCode])
  @@index([tenantId, enterpriseObjectId, status])
  @@map("duplicate_detection_rules")
}

model MasterDataMergeHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  enterpriseObjectId  String   @map("enterprise_object_id") @db.Uuid
  sourceRecordId      String   @map("source_record_id")
  targetRecordId      String   @map("target_record_id")
  mergeReason         String   @map("merge_reason")
  mergedById          String   @map("merged_by_id") @db.Uuid
  mergedAt            DateTime @default(now()) @map("merged_at")
  preservedReferences Json     @map("preserved_references")
  auditLogId          String?  @map("audit_log_id") @db.Uuid

  @@index([tenantId, enterpriseObjectId, sourceRecordId, targetRecordId])
  @@map("master_data_merge_history")
}

model MasterImportMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  enterpriseObjectId String   @map("enterprise_object_id") @db.Uuid
  mappingCode        String   @map("mapping_code")
  mappingName        String   @map("mapping_name")
  fileFormat         String   @map("file_format")
  columnMappings     Json     @map("column_mappings")
  validationRules    Json?    @map("validation_rules")
  status             String   @default("ACTIVE")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, mappingCode])
  @@map("master_import_mappings")
}

model MasterImportJob {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  companyId          String?           @map("company_id") @db.Uuid
  enterpriseObjectId String            @map("enterprise_object_id") @db.Uuid
  mappingId          String?           @map("mapping_id") @db.Uuid
  fileName           String            @map("file_name")
  fileFormat         String            @map("file_format")
  validationOnly     Boolean           @default(false) @map("validation_only")
  dryRun             Boolean           @default(false) @map("dry_run")
  status             String            @default("PENDING")
  totalRows          Int               @default(0) @map("total_rows")
  validRows          Int               @default(0) @map("valid_rows")
  invalidRows        Int               @default(0) @map("invalid_rows")
  duplicateRows      Int               @default(0) @map("duplicate_rows")
  processedRows      Int               @default(0) @map("processed_rows")
  rollbackMarker     String?           @map("rollback_marker")
  summary            Json?
  requestedById      String            @map("requested_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  rows               MasterImportRow[]

  @@index([tenantId, companyId, enterpriseObjectId, status, createdAt])
  @@map("master_import_jobs")
}

model MasterImportRow {
  id               String          @id @default(uuid()) @db.Uuid
  importJobId      String          @map("import_job_id") @db.Uuid
  rowNumber        Int             @map("row_number")
  rawData          Json            @map("raw_data")
  normalizedData   Json?           @map("normalized_data")
  validationStatus String          @default("PENDING") @map("validation_status")
  validationErrors Json?           @map("validation_errors")
  duplicateMatches Json?           @map("duplicate_matches")
  importedRecordId String?         @map("imported_record_id")
  rollbackStatus   String?         @map("rollback_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  importJob        MasterImportJob @relation(fields: [importJobId], references: [id])

  @@unique([importJobId, rowNumber])
  @@index([importJobId, validationStatus])
  @@map("master_import_rows")
}

model MasterExportJob {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  companyId          String?   @map("company_id") @db.Uuid
  enterpriseObjectId String    @map("enterprise_object_id") @db.Uuid
  fileFormat         String    @map("file_format")
  filters            Json?
  selectedFields     Json?     @map("selected_fields")
  status             String    @default("PENDING")
  rowCount           Int       @default(0) @map("row_count")
  fileReference      String?   @map("file_reference")
  requestedById      String    @map("requested_by_id") @db.Uuid
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, companyId, enterpriseObjectId, status, createdAt])
  @@map("master_export_jobs")
}

model TransactionDocument {
  id               String            @id @default(cuid())
  companyId        String            @db.Uuid
  module           ModuleCode
  kind             TransactionKind
  documentNo       String
  status           String
  amount           Decimal           @default(0) @db.Decimal(18, 2)
  currency         String            @default("USD")
  payload          Json              @default("{}")
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id])
  createdBy        User?             @relation("DocumentCreator", fields: [createdById], references: [id])
  parentLinks      TransactionLink[] @relation("ParentDocument")
  childLinks       TransactionLink[] @relation("ChildDocument")
  approvalRequests ApprovalRequest[]

  @@unique([companyId, documentNo])
  @@index([module, kind, status])
  @@map("transaction_documents")
}

model TransactionLink {
  id           String              @id @default(cuid())
  parentId     String
  childId      String
  relationType String              @default("NEXT_STEP")
  createdAt    DateTime            @default(now())
  parent       TransactionDocument @relation("ParentDocument", fields: [parentId], references: [id])
  child        TransactionDocument @relation("ChildDocument", fields: [childId], references: [id])

  @@unique([parentId, childId, relationType])
  @@map("transaction_links")
}

model ChartOfAccount {
  id           String           @id @default(cuid())
  companyId    String           @db.Uuid
  code         String
  name         String
  accountType  String
  parentId     String?
  isPosting    Boolean          @default(true)
  company      Company          @relation(fields: [companyId], references: [id])
  parent       ChartOfAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id               String        @id @default(cuid())
  companyId        String        @db.Uuid
  entryNo          String
  postingDate      DateTime
  memo             String?
  sourceDocumentId String?
  company          Company       @relation(fields: [companyId], references: [id])
  lines            JournalLine[]

  @@unique([companyId, entryNo])
  @@map("journal_entries")
}

model JournalLine {
  id         String         @id @default(cuid())
  entryId    String
  accountId  String
  debit      Decimal        @default(0) @db.Decimal(18, 2)
  credit     Decimal        @default(0) @db.Decimal(18, 2)
  costCenter String?
  entry      JournalEntry   @relation(fields: [entryId], references: [id])
  account    ChartOfAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}
