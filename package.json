{
  "name": "flowcraft-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Customizable manufacturing ERP platform with Next.js, NestJS, Prisma, and PostgreSQL.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev -w @flowcraft/api",
    "dev:web": "npm run dev -w @flowcraft/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @flowcraft/api",
    "prisma:migrate": "npm run prisma:migrate -w @flowcraft/api",
    "prisma:seed": "npm run prisma:seed -w @flowcraft/api"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.2.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/client@7.8.0": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
