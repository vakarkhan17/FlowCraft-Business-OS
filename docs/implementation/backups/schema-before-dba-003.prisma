generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  APPROVER
  FINANCE
  PURCHASING
  SALES
  WAREHOUSE
  PRODUCTION
  QC
  MAINTENANCE
  USER
}

enum ModuleCode {
  ACCOUNTING
  PURCHASING
  SALES
  WAREHOUSE
  MRP
  PRODUCTION
  QUALITY
  COSTING
  MAINTENANCE
  APPROVALS
  REPORTS
  PRINT_LAYOUTS
  DASHBOARD
  SETTINGS
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  JSON
}

enum TransactionKind {
  PURCHASE_REQUEST
  RFQ
  SUPPLIER_QUOTATION
  PURCHASE_ORDER
  GRN
  SUPPLIER_INVOICE
  PAYMENT
  SALES_INQUIRY
  SALES_QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  SALES_INVOICE
  RECEIPT
  BOM
  WORK_ORDER
  MATERIAL_ISSUE
  PRODUCTION_ENTRY
  QC_INSPECTION
  FINISHED_GOODS_RECEIPT
  MAINTENANCE_REQUEST
  MAINTENANCE_WORK_ORDER
  SPARE_PARTS_ISSUE
  MAINTENANCE_COMPLETION_REPORT
  JOURNAL_ENTRY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Tenant {
  id               String               @id @default(uuid()) @db.Uuid
  tenantCode       String               @unique @map("tenant_code")
  tenantName       String               @map("tenant_name")
  status           String               @default("ACTIVE")
  subscriptionPlan String?              @map("subscription_plan")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  companies        Company[]
  branches         Branch[]
  users            User[]
  settings         ClientSetting[]
  moduleSettings   ModuleSetting[]
  exchangeRates    ExchangeRate[]
  roles            AccessRole[]
  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  companyAccesses  CompanyAccess[]
  branchAccesses   BranchAccess[]
  workflows        WorkflowDefinition[]
  numberSeries     NumberSeries[]
  auditLogs        AuditLog[]

  @@map("tenants")
}

model Currency {
  id            String         @id @default(uuid()) @db.Uuid
  digitalDna    String         @unique @map("digital_dna")
  currencyCode  String         @unique @map("currency_code")
  currencyName  String         @map("currency_name")
  symbol        String?
  decimalPlaces Int            @default(2) @map("decimal_places")
  roundingRule  String         @default("HALF_UP") @map("rounding_rule")
  isBaseAllowed Boolean        @default(true) @map("is_base_allowed")
  status        String         @default("ACTIVE")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  baseCompanies Company[]
  fromRates     ExchangeRate[] @relation("FromCurrency")
  toRates       ExchangeRate[] @relation("ToCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  fromCurrencyId         String         @map("from_currency_id") @db.Uuid
  toCurrencyId           String         @map("to_currency_id") @db.Uuid
  rate                   Decimal        @db.Decimal(24, 10)
  rateDate               DateTime       @map("rate_date") @db.Date
  rateType               String         @default("SPOT") @map("rate_type")
  source                 String?
  status                 String         @default("ACTIVE")
  version                Int            @default(1)
  replacesExchangeRateId String?        @map("replaces_exchange_rate_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  tenant                 Tenant         @relation(fields: [tenantId], references: [id])
  fromCurrency           Currency       @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency             Currency       @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  replacesExchangeRate   ExchangeRate?  @relation("ExchangeRateRevisions", fields: [replacesExchangeRateId], references: [id])
  replacementRates       ExchangeRate[] @relation("ExchangeRateRevisions")

  @@unique([tenantId, fromCurrencyId, toCurrencyId, rateDate, rateType, version])
  @@index([tenantId, rateDate, status])
  @@map("exchange_rates")
}

model Company {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  digitalDna            String                @unique @map("digital_dna")
  companyCode           String                @map("company_code")
  companyName           String                @map("company_name")
  legalName             String?               @map("legal_name")
  baseCurrencyId        String                @map("base_currency_id") @db.Uuid
  countryCode           String?               @map("country_code")
  taxRegistrationNumber String?               @map("tax_registration_number")
  addressLine1          String?               @map("address_line_1")
  addressLine2          String?               @map("address_line_2")
  city                  String?
  state                 String?
  postalCode            String?               @map("postal_code")
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?               @map("logo_url")
  status                String                @default("ACTIVE")
  isActive              Boolean               @default(true) @map("is_active")
  isDeleted             Boolean               @default(false) @map("is_deleted")
  createdById           String?               @map("created_by_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedById           String?               @map("updated_by_id") @db.Uuid
  updatedAt             DateTime              @updatedAt @map("updated_at")
  deletedById           String?               @map("deleted_by_id") @db.Uuid
  deletedAt             DateTime?             @map("deleted_at")
  deletionReason        String?               @map("deletion_reason")
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  baseCurrency          Currency              @relation(fields: [baseCurrencyId], references: [id])
  branches              Branch[]
  warehouses            Warehouse[]
  users                 User[]
  customFields          CustomField[]
  workflows             WorkflowDefinition[]
  printLayouts          PrintLayoutTemplate[]
  reportDefinitions     ReportDefinition[]
  approvalRules         ApprovalRule[]
  numberingSeries       NumberSeries[]
  userRoles             UserRole[]
  companyAccesses       CompanyAccess[]
  branchAccesses        BranchAccess[]
  auditLogs             AuditLog[]
  items                 Item[]
  suppliers             Supplier[]
  customers             Customer[]
  documents             TransactionDocument[]
  chartOfAccounts       ChartOfAccount[]
  journalEntries        JournalEntry[]

  @@unique([tenantId, companyCode])
  @@index([tenantId, status, isDeleted])
  @@map("companies")
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  digitalDna     String         @unique @map("digital_dna")
  branchCode     String         @map("branch_code")
  branchName     String         @map("branch_name")
  branchType     String?        @map("branch_type")
  countryCode    String?        @map("country_code")
  state          String?
  city           String?
  addressLine1   String?        @map("address_line_1")
  addressLine2   String?        @map("address_line_2")
  postalCode     String?        @map("postal_code")
  phone          String?
  email          String?
  status         String         @default("ACTIVE")
  isActive       Boolean        @default(true) @map("is_active")
  isDeleted      Boolean        @default(false) @map("is_deleted")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedById    String?        @map("updated_by_id") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedById    String?        @map("deleted_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at")
  deletionReason String?        @map("deletion_reason")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  company        Company        @relation(fields: [companyId], references: [id])
  warehouses     Warehouse[]
  users          User[]
  userRoles      UserRole[]
  branchAccesses BranchAccess[]
  numberSeries   NumberSeries[]
  auditLogs      AuditLog[]

  @@unique([companyId, branchCode])
  @@index([tenantId, companyId, status, isDeleted])
  @@map("branches")
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String  @db.Uuid
  branchId  String? @db.Uuid
  name      String
  code      String
  isActive  Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])

  @@unique([companyId, code])
  @@map("warehouses")
}

model User {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  digitalDna       String                @unique @map("digital_dna")
  username         String
  email            String
  passwordHash     String                @map("password_hash")
  fullName         String                @map("full_name")
  defaultCompanyId String?               @map("default_company_id") @db.Uuid
  defaultBranchId  String?               @map("default_branch_id") @db.Uuid
  legacyRoles      Role[]                @default([USER]) @map("roles")
  status           String                @default("ACTIVE")
  lastLoginAt      DateTime?             @map("last_login_at")
  isActive         Boolean               @default(true) @map("is_active")
  isDeleted        Boolean               @default(false) @map("is_deleted")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  company          Company?              @relation(fields: [defaultCompanyId], references: [id])
  branch           Branch?               @relation(fields: [defaultBranchId], references: [id])
  userRoles        UserRole[]
  companyAccesses  CompanyAccess[]
  branchAccesses   BranchAccess[]
  createdDocuments TransactionDocument[] @relation("DocumentCreator")
  approvalHistory  ApprovalHistory[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, status, isDeleted])
  @@map("users")
}

model AccessRole {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  roleCode    String           @map("role_code")
  roleName    String           @map("role_name")
  description String?
  roleType    String           @default("CUSTOM") @map("role_type")
  status      String           @default("ACTIVE")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, roleCode])
  @@index([tenantId, status])
  @@map("roles")
}

model Permission {
  id                 String            @id @default(uuid()) @db.Uuid
  permissionCode     String            @unique @map("permission_code")
  permissionName     String            @map("permission_name")
  enterpriseObjectId String?           @map("enterprise_object_id") @db.Uuid
  action             String
  description        String?
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  enterpriseObject   EnterpriseObject? @relation(fields: [enterpriseObjectId], references: [id])
  roles              RolePermission[]

  @@index([enterpriseObjectId, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  allowed      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  role         AccessRole @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, permissionId])
  @@index([roleId, allowed])
  @@map("role_permissions")
}

model UserRole {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  roleId    String     @map("role_id") @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  branchId  String?    @map("branch_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  role      AccessRole @relation(fields: [roleId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])

  @@unique([tenantId, userId, roleId, companyId, branchId])
  @@index([userId, companyId, branchId])
  @@map("user_roles")
}

model CompanyAccess {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([tenantId, userId, companyId])
  @@map("company_access")
}

model BranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@unique([tenantId, userId, branchId])
  @@index([userId, companyId])
  @@map("branch_access")
}

model ClientSetting {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  key       String
  value     Json
  client    Tenant   @relation(fields: [clientId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
  @@map("client_settings")
}

model ModuleSetting {
  id        String     @id @default(cuid())
  clientId  String     @db.Uuid
  module    ModuleCode
  enabled   Boolean    @default(true)
  settings  Json       @default("{}")
  client    Tenant     @relation(fields: [clientId], references: [id])
  updatedAt DateTime   @updatedAt

  @@unique([clientId, module])
  @@map("module_settings")
}

model CustomField {
  id         String             @id @default(cuid())
  companyId  String             @db.Uuid
  module     ModuleCode
  entityName String
  fieldKey   String
  label      String
  fieldType  FieldType
  isRequired Boolean            @default(false)
  isActive   Boolean            @default(true)
  sortOrder  Int                @default(0)
  options    Json               @default("[]")
  validation Json               @default("{}")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  company    Company            @relation(fields: [companyId], references: [id])
  values     CustomFieldValue[]

  @@unique([companyId, entityName, fieldKey])
  @@map("custom_fields")
}

model CustomFieldValue {
  id         String      @id @default(cuid())
  fieldId    String
  recordId   String
  recordType String
  value      Json
  snapshotAt DateTime    @default(now())
  field      CustomField @relation(fields: [fieldId], references: [id])

  @@index([recordType, recordId])
  @@map("custom_field_values")
}

model EnterpriseObject {
  id                   String               @id @default(uuid()) @db.Uuid
  objectCode           String               @unique @map("object_code")
  objectName           String               @map("object_name")
  objectType           String               @map("object_type")
  objectCategory       String               @map("object_category")
  objectFamily         String               @map("object_family")
  ownerModule          String               @map("owner_module")
  framework            String               @default("FEOM")
  tableName            String?              @map("table_name")
  apiPath              String?              @map("api_path")
  supportsWorkflow     Boolean              @default(false) @map("supports_workflow")
  supportsAudit        Boolean              @default(true) @map("supports_audit")
  supportsAttachments  Boolean              @default(false) @map("supports_attachments")
  supportsCustomFields Boolean              @default(false) @map("supports_custom_fields")
  supportsImport       Boolean              @default(false) @map("supports_import")
  supportsExport       Boolean              @default(false) @map("supports_export")
  supportsReports      Boolean              @default(true) @map("supports_reports")
  supportsPrint        Boolean              @default(false) @map("supports_print")
  supportsAi           Boolean              @default(false) @map("supports_ai")
  status               String               @default("ACTIVE")
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  fields               ObjectField[]
  sourceRelationships  ObjectRelationship[] @relation("SourceObject")
  targetRelationships  ObjectRelationship[] @relation("TargetObject")
  permissions          Permission[]
  workflows            WorkflowDefinition[]
  numberSeries         NumberSeries[]
  auditLogs            AuditLog[]

  @@index([ownerModule, objectFamily, status])
  @@map("enterprise_objects")
}

model ObjectField {
  id                 String           @id @default(uuid()) @db.Uuid
  enterpriseObjectId String           @map("enterprise_object_id") @db.Uuid
  fieldCode          String           @map("field_code")
  fieldName          String           @map("field_name")
  label              String
  dataType           String           @map("data_type")
  isRequired         Boolean          @default(false) @map("is_required")
  isUnique           Boolean          @default(false) @map("is_unique")
  isSearchable       Boolean          @default(false) @map("is_searchable")
  isFilterable       Boolean          @default(false) @map("is_filterable")
  isSortable         Boolean          @default(false) @map("is_sortable")
  isVisible          Boolean          @default(true) @map("is_visible")
  isReadOnly         Boolean          @default(false) @map("is_read_only")
  defaultValue       Json?            @map("default_value")
  validationRule     Json?            @map("validation_rule")
  displayOrder       Int              @default(0) @map("display_order")
  sectionName        String?          @map("section_name")
  helpText           String?          @map("help_text")
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  enterpriseObject   EnterpriseObject @relation(fields: [enterpriseObjectId], references: [id])

  @@unique([enterpriseObjectId, fieldCode])
  @@index([enterpriseObjectId, status, displayOrder])
  @@map("object_fields")
}

model ObjectRelationship {
  id               String           @id @default(uuid()) @db.Uuid
  sourceObjectId   String           @map("source_object_id") @db.Uuid
  targetObjectId   String           @map("target_object_id") @db.Uuid
  relationshipType String           @map("relationship_type")
  relationshipName String           @map("relationship_name")
  cardinality      String
  isRequired       Boolean          @default(false) @map("is_required")
  cascadeRule      String           @default("RESTRICT") @map("cascade_rule")
  status           String           @default("ACTIVE")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sourceObject     EnterpriseObject @relation("SourceObject", fields: [sourceObjectId], references: [id])
  targetObject     EnterpriseObject @relation("TargetObject", fields: [targetObjectId], references: [id])

  @@unique([sourceObjectId, targetObjectId, relationshipName])
  @@index([sourceObjectId, relationshipType, status])
  @@map("object_relationships")
}

model WorkflowDefinition {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  companyId          String?              @map("company_id") @db.Uuid
  enterpriseObjectId String               @map("enterprise_object_id") @db.Uuid
  workflowCode       String               @map("workflow_code")
  workflowName       String               @map("workflow_name")
  module             ModuleCode?
  description        String?
  version            Int                  @default(1)
  status             String               @default("DRAFT")
  isPublished        Boolean              @default(false) @map("is_published")
  effectiveFrom      DateTime?            @map("effective_from")
  effectiveTo        DateTime?            @map("effective_to")
  createdById        String?              @map("created_by_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedById        String?              @map("updated_by_id") @db.Uuid
  updatedAt          DateTime             @updatedAt @map("updated_at")
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  company            Company?             @relation(fields: [companyId], references: [id])
  enterpriseObject   EnterpriseObject     @relation(fields: [enterpriseObjectId], references: [id])
  steps              WorkflowStep[]
  transitions        WorkflowTransition[]

  @@unique([tenantId, workflowCode, version])
  @@index([tenantId, enterpriseObjectId, status, isPublished])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id              String               @id @default(cuid())
  workflowId      String               @db.Uuid
  name            String
  code            String
  stepOrder       Int
  isEnabled       Boolean              @default(true)
  config          Json                 @default("{}")
  workflow        WorkflowDefinition   @relation(fields: [workflowId], references: [id])
  fromTransitions WorkflowTransition[] @relation("FromStep")
  toTransitions   WorkflowTransition[] @relation("ToStep")

  @@unique([workflowId, code])
  @@map("workflow_steps")
}

model WorkflowTransition {
  id         String             @id @default(cuid())
  workflowId String             @db.Uuid
  fromStepId String?
  toStepId   String?
  condition  Json               @default("{}")
  sortOrder  Int                @default(0)
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])
  fromStep   WorkflowStep?      @relation("FromStep", fields: [fromStepId], references: [id])
  toStep     WorkflowStep?      @relation("ToStep", fields: [toStepId], references: [id])

  @@unique([workflowId, fromStepId, toStepId])
  @@map("workflow_transitions")
}

model PrintLayoutTemplate {
  id           String               @id @default(cuid())
  companyId    String               @db.Uuid
  documentType TransactionKind
  name         String
  version      Int                  @default(1)
  isDefault    Boolean              @default(false)
  isActive     Boolean              @default(true)
  canvas       Json                 @default("{}")
  company      Company              @relation(fields: [companyId], references: [id])
  sections     PrintLayoutSection[]
  updatedAt    DateTime             @updatedAt

  @@unique([companyId, documentType, name, version])
  @@map("print_layout_templates")
}

model PrintLayoutSection {
  id          String              @id @default(cuid())
  templateId  String
  sectionKey  String
  label       String
  position    Json                @default("{}")
  style       Json                @default("{}")
  dataBinding String?
  content     Json                @default("{}")
  template    PrintLayoutTemplate @relation(fields: [templateId], references: [id])

  @@map("print_layout_sections")
}

model ReportDefinition {
  id          String         @id @default(cuid())
  companyId   String         @db.Uuid
  module      ModuleCode
  name        String
  baseEntity  String
  description String?
  isActive    Boolean        @default(true)
  settings    Json           @default("{}")
  company     Company        @relation(fields: [companyId], references: [id])
  fields      ReportField[]
  filters     ReportFilter[]
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, name])
  @@map("report_definitions")
}

model ReportField {
  id          String           @id @default(cuid())
  reportId    String
  fieldPath   String
  label       String
  dataType    FieldType
  sortOrder   Int              @default(0)
  grouping    Boolean          @default(false)
  aggregation String?
  formula     String?
  report      ReportDefinition @relation(fields: [reportId], references: [id])

  @@map("report_fields")
}

model ReportFilter {
  id         String           @id @default(cuid())
  reportId   String
  fieldPath  String
  operator   String
  value      Json?
  isRequired Boolean          @default(false)
  report     ReportDefinition @relation(fields: [reportId], references: [id])

  @@map("report_filters")
}

model ApprovalRule {
  id           String            @id @default(cuid())
  companyId    String            @db.Uuid
  module       ModuleCode
  documentType TransactionKind?
  name         String
  condition    Json              @default("{}")
  isActive     Boolean           @default(true)
  company      Company           @relation(fields: [companyId], references: [id])
  steps        ApprovalStep[]
  requests     ApprovalRequest[]

  @@map("approval_rules")
}

model ApprovalStep {
  id         String       @id @default(cuid())
  ruleId     String
  level      Int
  role       Role
  department String?
  minAmount  Decimal?     @db.Decimal(18, 2)
  maxAmount  Decimal?     @db.Decimal(18, 2)
  rule       ApprovalRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, level])
  @@map("approval_steps")
}

model ApprovalRequest {
  id           String              @id @default(cuid())
  ruleId       String
  documentId   String
  status       ApprovalStatus      @default(PENDING)
  currentLevel Int                 @default(1)
  requestedAt  DateTime            @default(now())
  completedAt  DateTime?
  rule         ApprovalRule        @relation(fields: [ruleId], references: [id])
  document     TransactionDocument @relation(fields: [documentId], references: [id])
  history      ApprovalHistory[]

  @@unique([ruleId, documentId])
  @@map("approval_requests")
}

model ApprovalHistory {
  id        String          @id @default(cuid())
  requestId String
  userId    String          @db.Uuid
  action    ApprovalStatus
  level     Int
  remarks   String?
  createdAt DateTime        @default(now())
  request   ApprovalRequest @relation(fields: [requestId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@map("approval_history")
}

model NumberSeries {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  branchId           String?          @map("branch_id") @db.Uuid
  enterpriseObjectId String           @map("enterprise_object_id") @db.Uuid
  seriesCode         String           @map("series_code")
  prefix             String           @default("")
  suffix             String           @default("")
  currentNumber      BigInt           @default(0) @map("current_number")
  paddingLength      Int              @default(5) @map("padding_length")
  resetFrequency     String           @default("NEVER") @map("reset_frequency")
  fiscalYearId       String?          @map("fiscal_year_id")
  status             String           @default("ACTIVE")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])
  enterpriseObject   EnterpriseObject @relation(fields: [enterpriseObjectId], references: [id])

  @@unique([tenantId, companyId, branchId, seriesCode, fiscalYearId])
  @@index([tenantId, companyId, branchId, status])
  @@map("number_series")
}

model AuditLog {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  companyId          String?           @map("company_id") @db.Uuid
  branchId           String?           @map("branch_id") @db.Uuid
  enterpriseObjectId String?           @map("enterprise_object_id") @db.Uuid
  recordId           String            @map("record_id")
  recordDigitalDna   String?           @map("record_digital_dna")
  action             String
  oldValue           Json?             @map("old_value")
  newValue           Json?             @map("new_value")
  reason             String?
  userId             String?           @map("user_id") @db.Uuid
  ipAddress          String?           @map("ip_address")
  userAgent          String?           @map("user_agent")
  traceId            String            @map("trace_id")
  requestSource      String?           @map("request_source")
  createdAt          DateTime          @default(now()) @map("created_at")
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  company            Company?          @relation(fields: [companyId], references: [id])
  branch             Branch?           @relation(fields: [branchId], references: [id])
  enterpriseObject   EnterpriseObject? @relation(fields: [enterpriseObjectId], references: [id])

  @@index([tenantId, recordId, createdAt])
  @@index([enterpriseObjectId, action, createdAt])
  @@map("audit_logs")
}

model Item {
  id           String  @id @default(cuid())
  companyId    String  @db.Uuid
  sku          String
  name         String
  itemType     String
  uom          String
  reorderLevel Decimal @default(0) @db.Decimal(18, 4)
  standardCost Decimal @default(0) @db.Decimal(18, 4)
  isActive     Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, sku])
  @@map("items")
}

model Supplier {
  id           String  @id @default(cuid())
  companyId    String  @db.Uuid
  code         String
  name         String
  email        String?
  phone        String?
  paymentTerms String?
  isActive     Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("suppliers")
}

model Customer {
  id          String  @id @default(cuid())
  companyId   String  @db.Uuid
  code        String
  name        String
  email       String?
  phone       String?
  creditLimit Decimal @default(0) @db.Decimal(18, 2)
  isActive    Boolean @default(true)
  company     Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("customers")
}

model TransactionDocument {
  id               String            @id @default(cuid())
  companyId        String            @db.Uuid
  module           ModuleCode
  kind             TransactionKind
  documentNo       String
  status           String
  amount           Decimal           @default(0) @db.Decimal(18, 2)
  currency         String            @default("USD")
  payload          Json              @default("{}")
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id])
  createdBy        User?             @relation("DocumentCreator", fields: [createdById], references: [id])
  parentLinks      TransactionLink[] @relation("ParentDocument")
  childLinks       TransactionLink[] @relation("ChildDocument")
  approvalRequests ApprovalRequest[]

  @@unique([companyId, documentNo])
  @@index([module, kind, status])
  @@map("transaction_documents")
}

model TransactionLink {
  id           String              @id @default(cuid())
  parentId     String
  childId      String
  relationType String              @default("NEXT_STEP")
  createdAt    DateTime            @default(now())
  parent       TransactionDocument @relation("ParentDocument", fields: [parentId], references: [id])
  child        TransactionDocument @relation("ChildDocument", fields: [childId], references: [id])

  @@unique([parentId, childId, relationType])
  @@map("transaction_links")
}

model ChartOfAccount {
  id           String           @id @default(cuid())
  companyId    String           @db.Uuid
  code         String
  name         String
  accountType  String
  parentId     String?
  isPosting    Boolean          @default(true)
  company      Company          @relation(fields: [companyId], references: [id])
  parent       ChartOfAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id               String        @id @default(cuid())
  companyId        String        @db.Uuid
  entryNo          String
  postingDate      DateTime
  memo             String?
  sourceDocumentId String?
  company          Company       @relation(fields: [companyId], references: [id])
  lines            JournalLine[]

  @@unique([companyId, entryNo])
  @@map("journal_entries")
}

model JournalLine {
  id         String         @id @default(cuid())
  entryId    String
  accountId  String
  debit      Decimal        @default(0) @db.Decimal(18, 2)
  credit     Decimal        @default(0) @db.Decimal(18, 2)
  costCenter String?
  entry      JournalEntry   @relation(fields: [entryId], references: [id])
  account    ChartOfAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}
