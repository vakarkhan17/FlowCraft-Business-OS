generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  APPROVER
  FINANCE
  PURCHASING
  SALES
  WAREHOUSE
  PRODUCTION
  QC
  MAINTENANCE
  USER
}

enum ModuleCode {
  ACCOUNTING
  PURCHASING
  SALES
  WAREHOUSE
  MRP
  PRODUCTION
  QUALITY
  COSTING
  MAINTENANCE
  APPROVALS
  REPORTS
  PRINT_LAYOUTS
  DASHBOARD
  SETTINGS
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  JSON
}

enum TransactionKind {
  PURCHASE_REQUEST
  RFQ
  SUPPLIER_QUOTATION
  PURCHASE_ORDER
  GRN
  SUPPLIER_INVOICE
  PAYMENT
  SALES_INQUIRY
  SALES_QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  SALES_INVOICE
  RECEIPT
  BOM
  WORK_ORDER
  MATERIAL_ISSUE
  PRODUCTION_ENTRY
  QC_INSPECTION
  FINISHED_GOODS_RECEIPT
  MAINTENANCE_REQUEST
  MAINTENANCE_WORK_ORDER
  SPARE_PARTS_ISSUE
  MAINTENANCE_COMPLETION_REPORT
  JOURNAL_ENTRY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Tenant {
  id                              String                            @id @default(uuid()) @db.Uuid
  tenantCode                      String                            @unique @map("tenant_code")
  tenantName                      String                            @map("tenant_name")
  status                          String                            @default("ACTIVE")
  subscriptionPlan                String?                           @map("subscription_plan")
  isActive                        Boolean                           @default(true) @map("is_active")
  createdAt                       DateTime                          @default(now()) @map("created_at")
  updatedAt                       DateTime                          @updatedAt @map("updated_at")
  companies                       Company[]
  branches                        Branch[]
  users                           User[]
  settings                        ClientSetting[]
  moduleSettings                  ModuleSetting[]
  exchangeRates                   ExchangeRate[]
  roles                           AccessRole[]
  rolePermissions                 RolePermission[]
  userRoles                       UserRole[]
  companyAccesses                 CompanyAccess[]
  branchAccesses                  BranchAccess[]
  workflows                       WorkflowDefinition[]
  numberSeries                    NumberSeries[]
  auditLogs                       AuditLog[]
  enterpriseGroups                EnterpriseGroup[]
  legalEntities                   LegalEntity[]
  plants                          Plant[]
  businessUnits                   BusinessUnit[]
  divisions                       Division[]
  departments                     Department[]
  sections                        Section[]
  teams                           Team[]
  locations                       Location[]
  costCenters                     CostCenter[]
  profitCenters                   ProfitCenter[]
  organizationNodes               OrganizationNode[]
  organizationRelationshipHistory OrganizationRelationshipHistory[]
  organizationInheritancePolicies OrganizationInheritancePolicy[]
  organizationSettingOverrides    OrganizationSettingOverride[]
  userOrganizationAccess          UserOrganizationAccess[]

  @@map("tenants")
}

model Currency {
  id                   String            @id @default(uuid()) @db.Uuid
  digitalDna           String            @unique @map("digital_dna")
  currencyCode         String            @unique @map("currency_code")
  currencyName         String            @map("currency_name")
  symbol               String?
  decimalPlaces        Int               @default(2) @map("decimal_places")
  roundingRule         String            @default("HALF_UP") @map("rounding_rule")
  isBaseAllowed        Boolean           @default(true) @map("is_base_allowed")
  status               String            @default("ACTIVE")
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  baseCompanies        Company[]
  fromRates            ExchangeRate[]    @relation("FromCurrency")
  toRates              ExchangeRate[]    @relation("ToCurrency")
  enterpriseGroupBases EnterpriseGroup[]
  legalEntityBases     LegalEntity[]     @relation("LegalEntityBaseCurrency")
  legalEntityReporting LegalEntity[]     @relation("LegalEntityReportingCurrency")
  companyReporting     Company[]         @relation("CompanyReportingCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  fromCurrencyId         String         @map("from_currency_id") @db.Uuid
  toCurrencyId           String         @map("to_currency_id") @db.Uuid
  rate                   Decimal        @db.Decimal(24, 10)
  rateDate               DateTime       @map("rate_date") @db.Date
  rateType               String         @default("SPOT") @map("rate_type")
  source                 String?
  status                 String         @default("ACTIVE")
  version                Int            @default(1)
  replacesExchangeRateId String?        @map("replaces_exchange_rate_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  tenant                 Tenant         @relation(fields: [tenantId], references: [id])
  fromCurrency           Currency       @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency             Currency       @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  replacesExchangeRate   ExchangeRate?  @relation("ExchangeRateRevisions", fields: [replacesExchangeRateId], references: [id])
  replacementRates       ExchangeRate[] @relation("ExchangeRateRevisions")

  @@unique([tenantId, fromCurrencyId, toCurrencyId, rateDate, rateType, version])
  @@index([tenantId, rateDate, status])
  @@map("exchange_rates")
}

model Company {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  digitalDna            String                @unique @map("digital_dna")
  companyCode           String                @map("company_code")
  companyName           String                @map("company_name")
  legalName             String?               @map("legal_name")
  baseCurrencyId        String                @map("base_currency_id") @db.Uuid
  countryCode           String?               @map("country_code")
  taxRegistrationNumber String?               @map("tax_registration_number")
  addressLine1          String?               @map("address_line_1")
  addressLine2          String?               @map("address_line_2")
  city                  String?
  state                 String?
  postalCode            String?               @map("postal_code")
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?               @map("logo_url")
  status                String                @default("ACTIVE")
  isActive              Boolean               @default(true) @map("is_active")
  isDeleted             Boolean               @default(false) @map("is_deleted")
  createdById           String?               @map("created_by_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedById           String?               @map("updated_by_id") @db.Uuid
  updatedAt             DateTime              @updatedAt @map("updated_at")
  deletedById           String?               @map("deleted_by_id") @db.Uuid
  deletedAt             DateTime?             @map("deleted_at")
  deletionReason        String?               @map("deletion_reason")
  legalEntityId         String?               @map("legal_entity_id") @db.Uuid
  enterpriseGroupId     String?               @map("enterprise_group_id") @db.Uuid
  parentCompanyId       String?               @map("parent_company_id") @db.Uuid
  companyType           String                @default("OPERATING_COMPANY") @map("company_type")
  reportingCurrencyId   String?               @map("reporting_currency_id") @db.Uuid
  fiscalCalendarId      String?               @map("fiscal_calendar_id") @db.Uuid
  timezone              String                @default("UTC")
  locale                String                @default("en")
  hierarchyPath         String                @default("/") @map("hierarchy_path")
  hierarchyLevel        Int                   @default(0) @map("hierarchy_level")
  effectiveFrom         DateTime              @default(now()) @map("effective_from")
  effectiveTo           DateTime?             @map("effective_to")
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  baseCurrency          Currency              @relation(fields: [baseCurrencyId], references: [id])
  reportingCurrency     Currency?             @relation("CompanyReportingCurrency", fields: [reportingCurrencyId], references: [id])
  legalEntity           LegalEntity?          @relation(fields: [legalEntityId], references: [id])
  enterpriseGroup       EnterpriseGroup?      @relation(fields: [enterpriseGroupId], references: [id])
  parentCompany         Company?              @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies        Company[]             @relation("CompanyHierarchy")
  branches              Branch[]
  warehouses            Warehouse[]
  users                 User[]
  customFields          CustomField[]
  workflows             WorkflowDefinition[]
  printLayouts          PrintLayoutTemplate[]
  reportDefinitions     ReportDefinition[]
  approvalRules         ApprovalRule[]
  numberingSeries       NumberSeries[]
  userRoles             UserRole[]
  companyAccesses       CompanyAccess[]
  branchAccesses        BranchAccess[]
  auditLogs             AuditLog[]
  items                 Item[]
  suppliers             Supplier[]
  customers             Customer[]
  documents             TransactionDocument[]
  chartOfAccounts       ChartOfAccount[]
  journalEntries        JournalEntry[]
  plants                Plant[]
  businessUnits         BusinessUnit[]
  divisions             Division[]
  departments           Department[]
  sections              Section[]
  teams                 Team[]
  locations             Location[]
  costCenters           CostCenter[]
  profitCenters         ProfitCenter[]
  organizationNodes     OrganizationNode[]

  @@unique([tenantId, companyCode])
  @@index([tenantId, status, isDeleted])
  @@map("companies")
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  digitalDna     String         @unique @map("digital_dna")
  branchCode     String         @map("branch_code")
  branchName     String         @map("branch_name")
  branchType     String?        @map("branch_type")
  countryCode    String?        @map("country_code")
  state          String?
  city           String?
  addressLine1   String?        @map("address_line_1")
  addressLine2   String?        @map("address_line_2")
  postalCode     String?        @map("postal_code")
  phone          String?
  email          String?
  status         String         @default("ACTIVE")
  isActive       Boolean        @default(true) @map("is_active")
  isDeleted      Boolean        @default(false) @map("is_deleted")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedById    String?        @map("updated_by_id") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedById    String?        @map("deleted_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at")
  deletionReason String?        @map("deletion_reason")
  parentBranchId String?        @map("parent_branch_id") @db.Uuid
  plantId        String?        @map("plant_id") @db.Uuid
  hierarchyPath  String         @default("/") @map("hierarchy_path")
  hierarchyLevel Int            @default(0) @map("hierarchy_level")
  timezone       String?
  effectiveFrom  DateTime       @default(now()) @map("effective_from")
  effectiveTo    DateTime?      @map("effective_to")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  company        Company        @relation(fields: [companyId], references: [id])
  parentBranch   Branch?        @relation("BranchHierarchy", fields: [parentBranchId], references: [id])
  childBranches  Branch[]       @relation("BranchHierarchy")
  primaryPlant   Plant?         @relation("BranchPrimaryPlant", fields: [plantId], references: [id])
  plants         Plant[]        @relation("PlantBranch")
  warehouses     Warehouse[]
  users          User[]
  userRoles      UserRole[]
  branchAccesses BranchAccess[]
  numberSeries   NumberSeries[]
  auditLogs      AuditLog[]
  locations      Location[]

  @@unique([companyId, branchCode])
  @@index([tenantId, companyId, status, isDeleted])
  @@map("branches")
}

model EnterpriseGroup {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  digitalDna     String        @unique @map("digital_dna")
  groupCode      String        @map("group_code")
  groupName      String        @map("group_name")
  legalName      String?       @map("legal_name")
  description    String?
  baseCurrencyId String?       @map("base_currency_id") @db.Uuid
  countryCode    String?       @map("country_code")
  status         String        @default("ACTIVE")
  isActive       Boolean       @default(true) @map("is_active")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  effectiveFrom  DateTime      @default(now()) @map("effective_from")
  effectiveTo    DateTime?     @map("effective_to")
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedById    String?       @map("updated_by_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedById    String?       @map("deleted_by_id") @db.Uuid
  deletedAt      DateTime?     @map("deleted_at")
  deletionReason String?       @map("deletion_reason")
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  baseCurrency   Currency?     @relation(fields: [baseCurrencyId], references: [id])
  legalEntities  LegalEntity[]
  companies      Company[]

  @@unique([tenantId, groupCode])
  @@index([tenantId, status, effectiveFrom, effectiveTo])
  @@map("enterprise_groups")
}

model LegalEntity {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  enterpriseGroupId     String?          @map("enterprise_group_id") @db.Uuid
  digitalDna            String           @unique @map("digital_dna")
  legalEntityCode       String           @map("legal_entity_code")
  legalEntityName       String           @map("legal_entity_name")
  legalName             String           @map("legal_name")
  registrationNumber    String?          @map("registration_number")
  taxRegistrationNumber String?          @map("tax_registration_number")
  countryCode           String           @map("country_code")
  baseCurrencyId        String           @map("base_currency_id") @db.Uuid
  reportingCurrencyId   String?          @map("reporting_currency_id") @db.Uuid
  fiscalCalendarId      String?          @map("fiscal_calendar_id") @db.Uuid
  status                String           @default("ACTIVE")
  isActive              Boolean          @default(true) @map("is_active")
  isDeleted             Boolean          @default(false) @map("is_deleted")
  effectiveFrom         DateTime         @default(now()) @map("effective_from")
  effectiveTo           DateTime?        @map("effective_to")
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedById           String?          @map("updated_by_id") @db.Uuid
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedById           String?          @map("deleted_by_id") @db.Uuid
  deletedAt             DateTime?        @map("deleted_at")
  deletionReason        String?          @map("deletion_reason")
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  enterpriseGroup       EnterpriseGroup? @relation(fields: [enterpriseGroupId], references: [id])
  baseCurrency          Currency         @relation("LegalEntityBaseCurrency", fields: [baseCurrencyId], references: [id])
  reportingCurrency     Currency?        @relation("LegalEntityReportingCurrency", fields: [reportingCurrencyId], references: [id])
  companies             Company[]
  plants                Plant[]

  @@unique([tenantId, legalEntityCode])
  @@index([tenantId, enterpriseGroupId, status])
  @@map("legal_entities")
}

model Plant {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  branchId             String?        @map("branch_id") @db.Uuid
  legalEntityId        String?        @map("legal_entity_id") @db.Uuid
  digitalDna           String         @unique @map("digital_dna")
  plantCode            String         @map("plant_code")
  plantName            String         @map("plant_name")
  plantType            String         @map("plant_type")
  countryCode          String         @map("country_code")
  state                String?
  city                 String?
  addressLine1         String?        @map("address_line_1")
  addressLine2         String?        @map("address_line_2")
  postalCode           String?        @map("postal_code")
  timezone             String         @default("UTC")
  productionCalendarId String?        @map("production_calendar_id") @db.Uuid
  defaultWarehouseId   String?        @map("default_warehouse_id")
  hierarchyPath        String         @default("/") @map("hierarchy_path")
  hierarchyLevel       Int            @default(0) @map("hierarchy_level")
  status               String         @default("ACTIVE")
  isActive             Boolean        @default(true) @map("is_active")
  isDeleted            Boolean        @default(false) @map("is_deleted")
  effectiveFrom        DateTime       @default(now()) @map("effective_from")
  effectiveTo          DateTime?      @map("effective_to")
  createdById          String?        @map("created_by_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedById          String?        @map("updated_by_id") @db.Uuid
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedById          String?        @map("deleted_by_id") @db.Uuid
  deletedAt            DateTime?      @map("deleted_at")
  deletionReason       String?        @map("deletion_reason")
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  company              Company        @relation(fields: [companyId], references: [id])
  branch               Branch?        @relation("PlantBranch", fields: [branchId], references: [id])
  legalEntity          LegalEntity?   @relation(fields: [legalEntityId], references: [id])
  primaryForBranches   Branch[]       @relation("BranchPrimaryPlant")
  departments          Department[]
  locations            Location[]
  costCenters          CostCenter[]
  profitCenters        ProfitCenter[]

  @@unique([companyId, plantCode])
  @@index([tenantId, companyId, status, effectiveFrom, effectiveTo])
  @@map("plants")
}

model BusinessUnit {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  parentBusinessUnitId String?        @map("parent_business_unit_id") @db.Uuid
  digitalDna           String         @unique @map("digital_dna")
  businessUnitCode     String         @map("business_unit_code")
  businessUnitName     String         @map("business_unit_name")
  description          String?
  responsibleUserId    String?        @map("responsible_user_id") @db.Uuid
  hierarchyPath        String         @default("/") @map("hierarchy_path")
  hierarchyLevel       Int            @default(0) @map("hierarchy_level")
  status               String         @default("ACTIVE")
  isActive             Boolean        @default(true) @map("is_active")
  isDeleted            Boolean        @default(false) @map("is_deleted")
  effectiveFrom        DateTime       @default(now()) @map("effective_from")
  effectiveTo          DateTime?      @map("effective_to")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  company              Company        @relation(fields: [companyId], references: [id])
  parentBusinessUnit   BusinessUnit?  @relation("BusinessUnitHierarchy", fields: [parentBusinessUnitId], references: [id])
  childBusinessUnits   BusinessUnit[] @relation("BusinessUnitHierarchy")
  divisions            Division[]
  departments          Department[]
  profitCenters        ProfitCenter[]

  @@unique([companyId, businessUnitCode])
  @@index([tenantId, companyId, parentBusinessUnitId])
  @@map("business_units")
}

model Division {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  businessUnitId    String?        @map("business_unit_id") @db.Uuid
  parentDivisionId  String?        @map("parent_division_id") @db.Uuid
  digitalDna        String         @unique @map("digital_dna")
  divisionCode      String         @map("division_code")
  divisionName      String         @map("division_name")
  description       String?
  responsibleUserId String?        @map("responsible_user_id") @db.Uuid
  hierarchyPath     String         @default("/") @map("hierarchy_path")
  hierarchyLevel    Int            @default(0) @map("hierarchy_level")
  status            String         @default("ACTIVE")
  isActive          Boolean        @default(true) @map("is_active")
  isDeleted         Boolean        @default(false) @map("is_deleted")
  effectiveFrom     DateTime       @default(now()) @map("effective_from")
  effectiveTo       DateTime?      @map("effective_to")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  company           Company        @relation(fields: [companyId], references: [id])
  businessUnit      BusinessUnit?  @relation(fields: [businessUnitId], references: [id])
  parentDivision    Division?      @relation("DivisionHierarchy", fields: [parentDivisionId], references: [id])
  childDivisions    Division[]     @relation("DivisionHierarchy")
  departments       Department[]
  profitCenters     ProfitCenter[]

  @@unique([companyId, divisionCode])
  @@index([tenantId, companyId, parentDivisionId])
  @@map("divisions")
}

model Department {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  plantId            String?       @map("plant_id") @db.Uuid
  businessUnitId     String?       @map("business_unit_id") @db.Uuid
  divisionId         String?       @map("division_id") @db.Uuid
  parentDepartmentId String?       @map("parent_department_id") @db.Uuid
  digitalDna         String        @unique @map("digital_dna")
  departmentCode     String        @map("department_code")
  departmentName     String        @map("department_name")
  departmentType     String?       @map("department_type")
  managerUserId      String?       @map("manager_user_id") @db.Uuid
  costCenterId       String?       @map("cost_center_id") @db.Uuid
  profitCenterId     String?       @map("profit_center_id") @db.Uuid
  hierarchyPath      String        @default("/") @map("hierarchy_path")
  hierarchyLevel     Int           @default(0) @map("hierarchy_level")
  status             String        @default("ACTIVE")
  isActive           Boolean       @default(true) @map("is_active")
  isDeleted          Boolean       @default(false) @map("is_deleted")
  effectiveFrom      DateTime      @default(now()) @map("effective_from")
  effectiveTo        DateTime?     @map("effective_to")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  company            Company       @relation(fields: [companyId], references: [id])
  plant              Plant?        @relation(fields: [plantId], references: [id])
  businessUnit       BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  division           Division?     @relation(fields: [divisionId], references: [id])
  parentDepartment   Department?   @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[]  @relation("DepartmentHierarchy")
  sections           Section[]
  teams              Team[]

  @@unique([companyId, departmentCode])
  @@index([tenantId, companyId, parentDepartmentId])
  @@map("departments")
}

model Section {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  departmentId     String     @map("department_id") @db.Uuid
  parentSectionId  String?    @map("parent_section_id") @db.Uuid
  digitalDna       String     @unique @map("digital_dna")
  sectionCode      String     @map("section_code")
  sectionName      String     @map("section_name")
  supervisorUserId String?    @map("supervisor_user_id") @db.Uuid
  hierarchyPath    String     @default("/") @map("hierarchy_path")
  hierarchyLevel   Int        @default(0) @map("hierarchy_level")
  status           String     @default("ACTIVE")
  isActive         Boolean    @default(true) @map("is_active")
  isDeleted        Boolean    @default(false) @map("is_deleted")
  effectiveFrom    DateTime   @default(now()) @map("effective_from")
  effectiveTo      DateTime?  @map("effective_to")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  company          Company    @relation(fields: [companyId], references: [id])
  department       Department @relation(fields: [departmentId], references: [id])
  parentSection    Section?   @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections    Section[]  @relation("SectionHierarchy")
  teams            Team[]

  @@unique([companyId, sectionCode])
  @@index([tenantId, departmentId, parentSectionId])
  @@map("sections")
}

model Team {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
