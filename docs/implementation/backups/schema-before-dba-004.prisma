  sourceObject     EnterpriseObject @relation("SourceObject", fields: [sourceObjectId], references: [id])
  targetObject     EnterpriseObject @relation("TargetObject", fields: [targetObjectId], references: [id])

  @@unique([sourceObjectId, targetObjectId, relationshipName])
  @@index([sourceObjectId, relationshipType, status])
  @@map("object_relationships")
}

model WorkflowDefinition {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  companyId          String?              @map("company_id") @db.Uuid
  enterpriseObjectId String               @map("enterprise_object_id") @db.Uuid
  workflowCode       String               @map("workflow_code")
  workflowName       String               @map("workflow_name")
  module             ModuleCode?
  description        String?
  version            Int                  @default(1)
  status             String               @default("DRAFT")
  isPublished        Boolean              @default(false) @map("is_published")
  effectiveFrom      DateTime?            @map("effective_from")
  effectiveTo        DateTime?            @map("effective_to")
  createdById        String?              @map("created_by_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedById        String?              @map("updated_by_id") @db.Uuid
  updatedAt          DateTime             @updatedAt @map("updated_at")
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  company            Company?             @relation(fields: [companyId], references: [id])
  enterpriseObject   EnterpriseObject     @relation(fields: [enterpriseObjectId], references: [id])
  steps              WorkflowStep[]
  transitions        WorkflowTransition[]

  @@unique([tenantId, workflowCode, version])
  @@index([tenantId, enterpriseObjectId, status, isPublished])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id              String               @id @default(cuid())
  workflowId      String               @db.Uuid
  name            String
  code            String
  stepOrder       Int
  isEnabled       Boolean              @default(true)
  config          Json                 @default("{}")
  workflow        WorkflowDefinition   @relation(fields: [workflowId], references: [id])
  fromTransitions WorkflowTransition[] @relation("FromStep")
  toTransitions   WorkflowTransition[] @relation("ToStep")

  @@unique([workflowId, code])
  @@map("workflow_steps")
}

model WorkflowTransition {
  id         String             @id @default(cuid())
  workflowId String             @db.Uuid
  fromStepId String?
  toStepId   String?
  condition  Json               @default("{}")
  sortOrder  Int                @default(0)
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])
  fromStep   WorkflowStep?      @relation("FromStep", fields: [fromStepId], references: [id])
  toStep     WorkflowStep?      @relation("ToStep", fields: [toStepId], references: [id])

  @@unique([workflowId, fromStepId, toStepId])
  @@map("workflow_transitions")
}

model PrintLayoutTemplate {
  id           String               @id @default(cuid())
  companyId    String               @db.Uuid
  documentType TransactionKind
  name         String
  version      Int                  @default(1)
  isDefault    Boolean              @default(false)
  isActive     Boolean              @default(true)
  canvas       Json                 @default("{}")
  company      Company              @relation(fields: [companyId], references: [id])
  sections     PrintLayoutSection[]
  updatedAt    DateTime             @updatedAt

  @@unique([companyId, documentType, name, version])
  @@map("print_layout_templates")
}

model PrintLayoutSection {
  id          String              @id @default(cuid())
  templateId  String
  sectionKey  String
  label       String
  position    Json                @default("{}")
  style       Json                @default("{}")
  dataBinding String?
  content     Json                @default("{}")
  template    PrintLayoutTemplate @relation(fields: [templateId], references: [id])

  @@map("print_layout_sections")
}

model ReportDefinition {
  id          String         @id @default(cuid())
  companyId   String         @db.Uuid
  module      ModuleCode
  name        String
  baseEntity  String
  description String?
  isActive    Boolean        @default(true)
  settings    Json           @default("{}")
  company     Company        @relation(fields: [companyId], references: [id])
  fields      ReportField[]
  filters     ReportFilter[]
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, name])
  @@map("report_definitions")
}

model ReportField {
  id          String           @id @default(cuid())
  reportId    String
  fieldPath   String
  label       String
  dataType    FieldType
  sortOrder   Int              @default(0)
  grouping    Boolean          @default(false)
  aggregation String?
  formula     String?
  report      ReportDefinition @relation(fields: [reportId], references: [id])

  @@map("report_fields")
}

model ReportFilter {
  id         String           @id @default(cuid())
  reportId   String
  fieldPath  String
  operator   String
  value      Json?
  isRequired Boolean          @default(false)
  report     ReportDefinition @relation(fields: [reportId], references: [id])

  @@map("report_filters")
}

model ApprovalRule {
  id           String            @id @default(cuid())
  companyId    String            @db.Uuid
  module       ModuleCode
  documentType TransactionKind?
  name         String
  condition    Json              @default("{}")
  isActive     Boolean           @default(true)
  company      Company           @relation(fields: [companyId], references: [id])
  steps        ApprovalStep[]
  requests     ApprovalRequest[]

  @@map("approval_rules")
}

model ApprovalStep {
  id         String       @id @default(cuid())
  ruleId     String
  level      Int
  role       Role
  department String?
  minAmount  Decimal?     @db.Decimal(18, 2)
  maxAmount  Decimal?     @db.Decimal(18, 2)
  rule       ApprovalRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, level])
  @@map("approval_steps")
}

model ApprovalRequest {
  id           String              @id @default(cuid())
  ruleId       String
  documentId   String
  status       ApprovalStatus      @default(PENDING)
  currentLevel Int                 @default(1)
  requestedAt  DateTime            @default(now())
  completedAt  DateTime?
  rule         ApprovalRule        @relation(fields: [ruleId], references: [id])
  document     TransactionDocument @relation(fields: [documentId], references: [id])
  history      ApprovalHistory[]

  @@unique([ruleId, documentId])
  @@map("approval_requests")
}

model ApprovalHistory {
  id        String          @id @default(cuid())
  requestId String
  userId    String          @db.Uuid
  action    ApprovalStatus
  level     Int
  remarks   String?
  createdAt DateTime        @default(now())
  request   ApprovalRequest @relation(fields: [requestId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@map("approval_history")
}

model NumberSeries {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  branchId           String?          @map("branch_id") @db.Uuid
  enterpriseObjectId String           @map("enterprise_object_id") @db.Uuid
  seriesCode         String           @map("series_code")
  prefix             String           @default("")
  suffix             String           @default("")
  currentNumber      BigInt           @default(0) @map("current_number")
  paddingLength      Int              @default(5) @map("padding_length")
  resetFrequency     String           @default("NEVER") @map("reset_frequency")
  fiscalYearId       String?          @map("fiscal_year_id")
  status             String           @default("ACTIVE")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])
  enterpriseObject   EnterpriseObject @relation(fields: [enterpriseObjectId], references: [id])

  @@unique([tenantId, companyId, branchId, seriesCode, fiscalYearId])
  @@index([tenantId, companyId, branchId, status])
  @@map("number_series")
}

model AuditLog {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  companyId          String?           @map("company_id") @db.Uuid
  branchId           String?           @map("branch_id") @db.Uuid
  enterpriseObjectId String?           @map("enterprise_object_id") @db.Uuid
  recordId           String            @map("record_id")
  recordDigitalDna   String?           @map("record_digital_dna")
  action             String
  oldValue           Json?             @map("old_value")
  newValue           Json?             @map("new_value")
  reason             String?
  userId             String?           @map("user_id") @db.Uuid
  ipAddress          String?           @map("ip_address")
  userAgent          String?           @map("user_agent")
  traceId            String            @map("trace_id")
  requestSource      String?           @map("request_source")
  createdAt          DateTime          @default(now()) @map("created_at")
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  company            Company?          @relation(fields: [companyId], references: [id])
  branch             Branch?           @relation(fields: [branchId], references: [id])
  enterpriseObject   EnterpriseObject? @relation(fields: [enterpriseObjectId], references: [id])

  @@index([tenantId, recordId, createdAt])
  @@index([enterpriseObjectId, action, createdAt])
  @@map("audit_logs")
}

model Item {
  id           String  @id @default(cuid())
  companyId    String  @db.Uuid
  sku          String
  name         String
  itemType     String
  uom          String
  reorderLevel Decimal @default(0) @db.Decimal(18, 4)
  standardCost Decimal @default(0) @db.Decimal(18, 4)
  isActive     Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, sku])
  @@map("items")
}

model Supplier {
  id           String  @id @default(cuid())
  companyId    String  @db.Uuid
  code         String
  name         String
  email        String?
  phone        String?
  paymentTerms String?
  isActive     Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("suppliers")
}

model Customer {
  id          String  @id @default(cuid())
  companyId   String  @db.Uuid
  code        String
  name        String
  email       String?
  phone       String?
  creditLimit Decimal @default(0) @db.Decimal(18, 2)
  isActive    Boolean @default(true)
  company     Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("customers")
}

model TransactionDocument {
  id               String            @id @default(cuid())
  companyId        String            @db.Uuid
  module           ModuleCode
  kind             TransactionKind
  documentNo       String
  status           String
  amount           Decimal           @default(0) @db.Decimal(18, 2)
  currency         String            @default("USD")
  payload          Json              @default("{}")
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id])
  createdBy        User?             @relation("DocumentCreator", fields: [createdById], references: [id])
  parentLinks      TransactionLink[] @relation("ParentDocument")
  childLinks       TransactionLink[] @relation("ChildDocument")
  approvalRequests ApprovalRequest[]

  @@unique([companyId, documentNo])
  @@index([module, kind, status])
  @@map("transaction_documents")
}

model TransactionLink {
  id           String              @id @default(cuid())
  parentId     String
  childId      String
  relationType String              @default("NEXT_STEP")
  createdAt    DateTime            @default(now())
  parent       TransactionDocument @relation("ParentDocument", fields: [parentId], references: [id])
  child        TransactionDocument @relation("ChildDocument", fields: [childId], references: [id])

  @@unique([parentId, childId, relationType])
  @@map("transaction_links")
}

model ChartOfAccount {
  id           String           @id @default(cuid())
  companyId    String           @db.Uuid
  code         String
  name         String
  accountType  String
  parentId     String?
  isPosting    Boolean          @default(true)
  company      Company          @relation(fields: [companyId], references: [id])
  parent       ChartOfAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id               String        @id @default(cuid())
  companyId        String        @db.Uuid
  entryNo          String
  postingDate      DateTime
  memo             String?
  sourceDocumentId String?
  company          Company       @relation(fields: [companyId], references: [id])
  lines            JournalLine[]

  @@unique([companyId, entryNo])
  @@map("journal_entries")
}

model JournalLine {
  id         String         @id @default(cuid())
  entryId    String
  accountId  String
  debit      Decimal        @default(0) @db.Decimal(18, 2)
  credit     Decimal        @default(0) @db.Decimal(18, 2)
  costCenter String?
  entry      JournalEntry   @relation(fields: [entryId], references: [id])
  account    ChartOfAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}
